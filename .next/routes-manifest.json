{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/compliance/[itemId]",
      "regex": "^/compliance/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPitemId": "nxtPitemId"
      },
      "namedRegex": "^/compliance/(?<nxtPitemId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/fit-score/[bidId]",
      "regex": "^/fit\\-score/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbidId": "nxtPbidId"
      },
      "namedRegex": "^/fit\\-score/(?<nxtPbidId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/opportunities/[id]",
      "regex": "^/opportunities/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/opportunities/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/assembly",
      "regex": "^/assembly(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/assembly(?:/)?$"
    },
    {
      "page": "/bids",
      "regex": "^/bids(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bids(?:/)?$"
    },
    {
      "page": "/compliance",
      "regex": "^/compliance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/compliance(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/intake",
      "regex": "^/intake(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/intake(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/notifications",
      "regex": "^/notifications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/notifications(?:/)?$"
    },
    {
      "page": "/opportunities",
      "regex": "^/opportunities(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/opportunities(?:/)?$"
    },
    {
      "page": "/profile",
      "regex": "^/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/profile(?:/)?$"
    },
    {
      "page": "/settings/security",
      "regex": "^/settings/security(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings/security(?:/)?$"
    },
    {
      "page": "/settings/team",
      "regex": "^/settings/team(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings/team(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    },
    {
      "page": "/submit",
